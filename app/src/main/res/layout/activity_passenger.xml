<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Background Image -->
    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/gustavus_adolphus_college"
        android:alpha="0.6"
        android:contentDescription="Campus background" />

    <!-- Foreground UI -->
    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingBottom="75dp"
        android:layout_gravity="center"
        android:gravity="top|center_horizontal">


    <!-- Switching Drivers Text -->
        <TextView
            android:id="@+id/driverSwitchTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Switching Drivers..."
            android:visibility="gone"
            android:textSize="16sp"
            android:textColor="@android:color/darker_gray"
            android:textStyle="italic" />

        <!-- Queue Title -->
        <TextView
            android:id="@+id/rideQueueTitleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Queue"
            android:textSize="40sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_marginTop="50dp"
            android:layout_gravity="center_horizontal"
            android:shadowColor="#80000000"
            android:shadowDx="10"
            android:shadowDy="10"
            android:shadowRadius="10"/>


        <!-- Queue -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rideQueueRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="600dp"
            android:background="@android:color/transparent"
            android:layout_marginTop="12dp"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:padding="8dp" />

        <!-- Ride Status -->
        <TextView
            android:id="@+id/passengerRideStatusTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/border_layout"
            android:text="Your ride is in position: -"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="8dp"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"/>

        <!-- Request Ride Button -->
        <Button
            android:id="@+id/requestRideButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Request Ride"
            android:textSize="25sp"
            android:layout_marginTop="40dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/rounded_rectangle"
            android:textColor="@android:color/black"
            android:paddingLeft="30dp"
            android:paddingRight="30dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp" />

    </LinearLayout>

    <!-- Fixed bottom buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="bottom"
        android:padding="24dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/backButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Back"
            android:textSize="16sp"
            android:drawableLeft="@android:drawable/ic_media_previous"
            android:background="@drawable/rounded_rectangle"
            android:backgroundTint="@android:color/darker_gray"
            android:textColor="@android:color/white"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/cancelRideButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Cancel Ride"
            android:textSize="16sp"
            android:background="@drawable/rounded_rectangle"
            android:backgroundTint="@color/red"
            android:textColor="@android:color/white"
            android:layout_marginStart="8dp" />
    </LinearLayout>
</FrameLayout>


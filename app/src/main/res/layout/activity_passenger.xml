<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background Image -->
    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/background"
        android:alpha="0.2"
        android:contentDescription="Campus background" />

    <!-- Foreground UI -->
    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- Switching Drivers Text -->
        <TextView
            android:id="@+id/driverSwitchTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Switching Drivers..."
            android:visibility="gone"
            android:textSize="16sp"
            android:textColor="@android:color/darker_gray"
            android:textStyle="italic" />

        <!-- Pickup Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pickup:"
                android:textSize="18sp"
                android:gravity="end"
                android:layout_marginEnd="10dp" />

            <Spinner
                android:id="@+id/pickupSpinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Drop-off Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Drop-off:"
                android:textSize="18sp"
                android:gravity="end"
                android:layout_marginEnd="10dp" />

            <Spinner
                android:id="@+id/dropOffSpinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Passenger Count Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Passengers:"
                android:textSize="18sp"
                android:gravity="end"
                android:layout_marginEnd="10dp" />

            <Spinner
                android:id="@+id/passengerCountSpinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Ride Queue RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rideQueueRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="8dp" />

        <!-- Ride Status -->
        <TextView
            android:id="@+id/passengerRideStatusTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your ride is in position: -"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="8dp"
            android:gravity="center" />

        <!-- Request Ride Button -->
        <Button
            android:id="@+id/requestRideButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Request Ride"
            android:textSize="18sp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/gold"
            android:textColor="@android:color/black"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />
    </LinearLayout>

    <!-- Back Button anchored bottom-left -->
    <Button
        android:id="@+id/backButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Back"
        android:drawableLeft="@android:drawable/ic_media_previous"
        android:textSize="16sp"
        android:backgroundTint="@android:color/darker_gray"
        android:textColor="@android:color/white"
        android:layout_gravity="bottom|start"
        android:layout_margin="24dp"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp" />
    <!-- Cancel Ride Button anchored bottom-right -->
    <Button
        android:id="@+id/cancelRideButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cancel Ride"
        android:textSize="16sp"
        android:backgroundTint="@color/red"
        android:textColor="@android:color/white"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp" />

</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Background Image -->
    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/gustavus_adolphus_college"
        android:alpha="0.6"
        android:contentDescription="Campus background" />

    <!-- Main content vertically centered -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:id="@+id/welcomeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome to the Safe Rides App at Gustavus Adolphus College."
            android:textSize="30sp"
            android:textAlignment="center"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:shadowColor="#80000000"
            android:shadowDx="10"
            android:shadowDy="10"
            android:shadowRadius="10"/>

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:elevation="8dp"
            card_view:cardCornerRadius="50dp"
            card_view:cardBackgroundColor="@android:color/transparent">

        </androidx.cardview.widget.CardView>

        <Button
            android:layout_width="275dp"
            android:layout_height="100dp"
            android:id="@+id/passengerButton"
            android:backgroundTint="@color/gold"
            android:text="Request a Ride/view queue"
            android:textColor="@android:color/black"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginTop="450dp"/>


    </LinearLayout>

    <!-- Driver button now floating in bottom-right corner -->
    <Button
        android:id="@+id/driverButton"
        android:layout_width="160dp"
        android:layout_height="50dp"
        android:layout_gravity="bottom"
        android:layout_margin="24dp"
        android:backgroundTint="@color/gold"
        android:elevation="6dp"
        android:text="I am a DRIVER"
        android:textColor="@android:color/black"
        android:textSize="16sp"
        android:textStyle="bold" />
</FrameLayout>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <!-- Title -->

    <TextView
        android:id="@+id/pickupsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pick ups"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- RecyclerView for the queue -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/driverRideQueue"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/pickupsTitle"
        app:layout_constraintBottom_toTopOf="@id/hereButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Main action button -->

    <!-- Switch drivers -->
    <Button
        android:id="@+id/hereButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="212dp"
        android:layout_marginBottom="16dp"
        android:text="At pick up location"
        android:textSize="18sp"
        app:layout_constraintBottom_toTopOf="@+id/switchingDriversButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/switchingDriversButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Switch Driver"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@+id/logOffButton"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Log out -->
    <Button
        android:id="@+id/logOffButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Log Out"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
